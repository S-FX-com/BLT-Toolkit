{
    "name": "s-fx/blt-toolkit",
    "description": "Dev tooling for BLT Toolkit. The plugin itself has ZERO runtime Composer dependencies.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/S-FX-com/BLT-Toolkit",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcsstandards/phpcsutils": "^1.0",
        "phpcsstandards/phpcsextra": "^1.2",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "scripts": {
        "lint": "find . \\( -path ./vendor -o -path ./includes/lib -o -path ./node_modules -o -path ./build \\) -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "authors": [
        {
            "name": "S-FX.com",
            "homepage": "https://www.s-fx.com"
        }
    ]
}
